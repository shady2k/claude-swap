#!/bin/sh
# claude-swap's thin `claude` wrapper: every launch runs
#
#     cswap run --auto -- "$@"
#
# so the account with the most quota left is chosen and started as its own
# session profile, with its own proxy, and the default login is never
# switched. Install it as a symlink in a directory ahead of the real Claude
# Code in PATH:
#
#     ln -s "$(cswap wrapper)" ~/.local/bin/claude
#
# Rules: docs/auto-launch.md. Mechanism, including the recursion guard:
# claude_swap/wrapper.py.
set -u

# Where this file really is, with symlinks resolved (macOS has no `readlink -f`).
self=$0
while [ -L "$self" ]; do
    link=$(readlink "$self") || exit 1
    case $link in
        /*) self=$link ;;
        *) self=$(dirname "$self")/$link ;;
    esac
done
self_dir=$(CDPATH= cd "$(dirname "$self")" && pwd -P) || exit 1
self=$self_dir/$(basename "$self")

# The real Claude Code: the path cswap handed down, or the first `claude` on
# PATH that is not this file. It goes back to cswap in CSWAP_REAL_CLAUDE,
# which is how cswap finds it without finding this wrapper again.
if [ -z "${CSWAP_REAL_CLAUDE:-}" ]; then
    old_ifs=$IFS
    IFS=:
    for dir in ${PATH:-}; do
        [ -n "$dir" ] || dir=.
        if [ -f "$dir/claude" ] && [ -x "$dir/claude" ] &&
           [ ! "$dir/claude" -ef "$self" ]; then
            CSWAP_REAL_CLAUDE=$dir/claude
            break
        fi
    done
    IFS=$old_ifs
fi

if [ -z "${CSWAP_REAL_CLAUDE:-}" ]; then
    echo "claude: this is claude-swap's wrapper, and no Claude Code binary is on PATH." >&2
    echo "claude: install Claude Code, or put its binary ahead of this wrapper." >&2
    exit 127
fi
export CSWAP_REAL_CLAUDE

if ! command -v cswap >/dev/null 2>&1; then
    echo "claude: cswap is not on PATH, so the wrapper cannot choose an account." >&2
    echo "claude: install claude-swap (uv tool install claude-swap) or run $CSWAP_REAL_CLAUDE directly." >&2
    exit 127
fi

exec cswap run --auto -- "$@"
